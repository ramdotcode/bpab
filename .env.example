# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local tidak ikut ter-commit ke git.

# ==== Konfigurasi Server (jalan lokal di komputer) ====
PORT=3000

# ==== Database BPAB (READ-ONLY, hanya SELECT) ====
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# ==== WhaCenter (untuk kirim WA) ====
WHACENTER_DEVICE_ID=
WHACENTER_BASE=

# Periode berjalan default untuk fitur "Pengingat Foto Meteran" (kosongkan = pakai bulan sekarang)
PERIODE_TAHUN=
PERIODE_BULAN=

# ==== Input Meteran (satu-satunya fitur yang MENULIS ke database) ====
# false = seluruh penyimpanan jadi simulasi saja (tidak menulis apa pun)
IZINKAN_TULIS_METERAN=false
# Nilai kolom user_input, mengikuti aplikasi lama
USER_INPUT_ID=

# ==== Tambah Pelanggan ====
# false = simulasi saja (tidak menulis apa pun)
IZINKAN_TAMBAH_PELANGGAN=false
